<Project>

  <!--
    Builds a project's client-side (npm) code as part of "dotnet build". Paths are relative to the project.

    A project opts in by setting these properties:

      FormulateClientDirectory        The folder that holds package.json (such as Client).
      FormulateClientOutput           The main built file. MSBuild skips the npm build while it is newer than every input.
      FormulateClientOutputDirectory  The folder the npm build writes to (such as wwwroot/App_Plugins/Formulate). Everything
                                      in it is added as content, so a clean build still serves and packs the new files.

    and may set these:

      FormulateClientExtraInputs      More files to watch, relative to the client directory and separated by ";"
                                      (for example themes/**). They are added to FormulateClientInputs.
      FormulateClientInputs           Replaces the default list of watched files (relative to the client directory):
                                      src/**;public/**;package.json;package-lock.json;vite.config.ts;tsconfig.json
      FormulateClientUsesVersion      true when the client shows the package's version, such as 5.0.0-rc.1. The npm
                                      build gets it as FORMULATE_VERSION, and runs again whenever it changes.
      SkipClientBuild                 Pass -p:SkipClientBuild=true on the command line to skip the npm build.

    The client directory is left out of the project's default items, so package.json, node_modules and the tests never
    reach the build output or the package. IDE design-time builds never run npm. "npm ci" runs when package-lock.json
    is newer than node_modules/.package-lock.json (which npm writes on install) or node_modules is missing.
  -->
  <PropertyGroup Condition="'$(FormulateClientDirectory)' != ''">
    <DefaultItemExcludes>$(DefaultItemExcludes);$(FormulateClientDirectory)/**</DefaultItemExcludes>

    <FormulateClientInputs Condition="'$(FormulateClientInputs)' == ''">src/**;public/**;package.json;package-lock.json;vite.config.ts;tsconfig.json</FormulateClientInputs>
    <FormulateClientInputs Condition="'$(FormulateClientExtraInputs)' != ''">$(FormulateClientInputs);$(FormulateClientExtraInputs)</FormulateClientInputs>
    <!-- The same list with the client directory in front of each entry. -->
    <_FormulateClientInputPaths>$([MSBuild]::Unescape($(FormulateClientDirectory)/$(FormulateClientInputs.Replace(';', ';$(FormulateClientDirectory)/'))))</_FormulateClientInputPaths>
  </PropertyGroup>

  <!-- The client files the npm build reads (globs are only expanded in items, not in target Inputs). -->
  <ItemGroup Condition="'$(FormulateClientDirectory)' != ''">
    <FormulateClientInput Include="$(_FormulateClientInputPaths)" />
  </ItemGroup>

  <PropertyGroup>
    <_FormulateClientActive Condition="'$(FormulateClientDirectory)' != '' and '$(FormulateClientOutput)' != '' and '$(DesignTimeBuild)' != 'true'">true</_FormulateClientActive>
    <!--
      Holds the version the client was last built with, for FormulateClientUsesVersion. It sits in obj itself, not in a
      configuration's folder, because every configuration shares the one client output.
    -->
    <_FormulateClientVersionStamp Condition="'$(FormulateClientUsesVersion)' == 'true'">$(BaseIntermediateOutputPath)formulate-client-version.txt</_FormulateClientVersionStamp>
  </PropertyGroup>

  <!-- Installs the npm packages when the lock file changes (npm writes node_modules/.package-lock.json on install). -->
  <Target Name="FormulateRestoreClient"
          Condition="'$(_FormulateClientActive)' == 'true' and '$(SkipClientBuild)' != 'true'"
          Inputs="$(FormulateClientDirectory)/package-lock.json"
          Outputs="$(FormulateClientDirectory)/node_modules/.package-lock.json">
    <Message Importance="high" Text="Installing the client packages in $(FormulateClientDirectory) (npm ci)." />
    <Exec Command="npm ci" WorkingDirectory="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(FormulateClientDirectory)'))" />
  </Target>

  <!--
    Writes the package version to the stamp file, but only when it differs from the one there. As one of the npm
    build's inputs, the stamp then makes a build with another version (such as -p:Version=5.0.0-rc.1) build the
    client again, and the next build without one too.
  -->
  <Target Name="FormulateStampClientVersion"
          Condition="'$(_FormulateClientActive)' == 'true' and '$(SkipClientBuild)' != 'true' and '$(_FormulateClientVersionStamp)' != ''">
    <WriteLinesToFile File="$(_FormulateClientVersionStamp)" Lines="$(PackageVersion)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Runs the npm build when a client source (or the version stamp) is newer than the built file. -->
  <Target Name="FormulateBuildClient"
          DependsOnTargets="FormulateRestoreClient;FormulateStampClientVersion"
          BeforeTargets="AssignTargetPaths;ResolveStaticWebAssetsInputs"
          Condition="'$(_FormulateClientActive)' == 'true' and '$(SkipClientBuild)' != 'true'"
          Inputs="@(FormulateClientInput);$(_FormulateClientVersionStamp)"
          Outputs="$(FormulateClientOutput)">
    <PropertyGroup>
      <_FormulateClientEnvironment Condition="'$(_FormulateClientVersionStamp)' != ''">FORMULATE_VERSION=$(PackageVersion)</_FormulateClientEnvironment>
    </PropertyGroup>
    <Message Importance="high" Text="Building the client code in $(FormulateClientDirectory) (npm run build)." />
    <Exec Command="npm run build" WorkingDirectory="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(FormulateClientDirectory)'))" EnvironmentVariables="$(_FormulateClientEnvironment)" />
  </Target>

  <!--
    The project's item lists were collected before the build started, so they miss what the npm build
    changed. This adds the files it created as content, so that a clean build still serves and packs them,
    and drops the output files it deleted (such as chunks whose hashed names changed), which would otherwise
    fail the build. It always runs (even when the npm build is skipped), right before static web assets are
    worked out.
  -->
  <Target Name="FormulateIncludeClientOutput"
          DependsOnTargets="FormulateBuildClient"
          BeforeTargets="AssignTargetPaths;ResolveStaticWebAssetsInputs"
          Condition="'$(_FormulateClientActive)' == 'true' and '$(FormulateClientOutputDirectory)' != ''">
    <PropertyGroup>
      <_FormulateClientOutputFullPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(FormulateClientOutputDirectory)/'))</_FormulateClientOutputFullPath>
    </PropertyGroup>
    <ItemGroup>
      <_FormulateDeletedFile Include="@(Content)" Condition="!Exists('%(Content.FullPath)') and $([System.String]::Copy('%(Content.FullPath)').StartsWith('$(_FormulateClientOutputFullPath)'))" />
      <Content Remove="@(_FormulateDeletedFile)" />
      <_FormulateDeletedFile Remove="@(_FormulateDeletedFile)" />

      <FormulateGeneratedFile Include="$(FormulateClientOutputDirectory)/**" />
      <!-- Release builds (and so packages) leave out source maps, which only help while debugging. -->
      <FormulateGeneratedFile Remove="$(FormulateClientOutputDirectory)/**/*.map" Condition="'$(Configuration)' == 'Release'" />
      <Content Remove="$(FormulateClientOutputDirectory)/**/*.map" Condition="'$(Configuration)' == 'Release'" />
      <Content Include="@(FormulateGeneratedFile)" Exclude="@(Content)" />
      <FormulateGeneratedFile Remove="@(FormulateGeneratedFile)" />
    </ItemGroup>
  </Target>

</Project>
