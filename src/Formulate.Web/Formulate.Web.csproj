<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- This project is annotated for nullable reference types, unlike the shared default. -->
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <Title>Formulate.Web</Title>
        <Description>Web functionality for Formulate, an advanced form builder for Umbraco.</Description>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Umbraco.Cms.Web.Common" />
        <PackageReference Include="Umbraco.Cms.Web.Website" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Formulate.Core\Formulate.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Formulate.Web.Tests" />
    </ItemGroup>

</Project>
