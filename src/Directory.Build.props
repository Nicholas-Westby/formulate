<Project>

  <!-- Compiler settings shared by every project under src. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The existing code is not annotated for nullable reference types. New projects may opt in. -->
    <Nullable>disable</Nullable>
    <!-- Using an [Obsolete] member is an error, so APIs Umbraco plans to remove fail the build. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0612;CS0618</WarningsAsErrors>
    <!-- Libraries only audit their direct references: the dev site audits everything at the real site version. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <!-- Umbraco versions. Override on the command line, e.g. -p:UmbracoSiteVersion=18.3.2 -->
  <PropertyGroup>
    <!-- Every library depends on this range: compiled against the floor, allowed on later majors. -->
    <UmbracoVersionRange Condition="'$(UmbracoVersionRange)' == ''">[17.8.2, 20.0.0)</UmbracoVersionRange>
    <!--
      The range's floor without a prerelease label, such as 17.8.2. CI's compile checks build the libraries
      against a later Umbraco with an exact range, such as -p:UmbracoVersionRange=[19.0.0-rc1], and the
      settings below follow it (Directory.Packages.props uses it too).
    -->
    <UmbracoFloorVersion>$([System.Text.RegularExpressions.Regex]::Match('$(UmbracoVersionRange)', '\d+\.\d+\.\d+').Value)</UmbracoFloorVersion>
    <!--
      Umbraco 19 targets .NET 11 only, so a build against it does too. The packages stay one net10.0 build.
      Set here rather than only by -p:TargetFramework, which neither restore nor project references pass on.
    -->
    <TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(UmbracoFloorVersion)', '19.0.0'))">net11.0</TargetFramework>
    <!-- The exact version the dev site runs. -->
    <UmbracoSiteVersion Condition="'$(UmbracoSiteVersion)' == ''">17.8.2</UmbracoSiteVersion>
    <!-- First segment of the site version. Split as a string, since "19.0.0-rc1" is not a System.Version. -->
    <UmbracoMajor>$(UmbracoSiteVersion.Split('.')[0])</UmbracoMajor>
  </PropertyGroup>

  <!-- Package metadata. A project opts in to packing with <IsPackable>true</IsPackable>. -->
  <PropertyGroup>
    <VersionPrefix>5.0.0</VersionPrefix>
    <IsPackable>false</IsPackable>
    <PackageId>Umbraco.Community.$(MSBuildProjectName)</PackageId>
    <Authors>Nicholas Westby, Jamie Pollock</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.formulate.rocks/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Nicholas-Westby/formulate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco umbraco-cms forms form-builder formulate</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- MSBuild evaluates item conditions after all properties, so this sees the project's IsPackable. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\docs\nuget\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\assets\images\formulate-icon-zoomed-out.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

</Project>
