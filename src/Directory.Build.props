<Project InitialTargets="FormulateCheckUmbracoRanges">

  <!-- Compiler settings shared by every project under src. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The existing code is not annotated for nullable reference types. New projects may opt in. -->
    <Nullable>disable</Nullable>
    <!-- Using an [Obsolete] member is an error, so APIs Umbraco plans to remove fail the build. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0612;CS0618</WarningsAsErrors>
    <!-- Libraries only audit their direct references: the dev site audits everything at the real site version. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <!--
    Umbraco versions. Override them on the command line, such as -p:UmbracoSiteVersion=18.3.2.

    UmbracoSupportedRange  The Umbraco versions a site may run Formulate on. Umbraco.Community.Formulate, the
                           package sites install, depends on Umbraco with this range (src/Formulate/Formulate.csproj).
    UmbracoCompileRange    The range the libraries and their tests depend on. NuGet compiles them against its lowest
                           version, 17.7.2, which no site gets: the supported range keeps sites on 17.8.2 or later.

    The libraries compile against an older Umbraco than the supported minimum because of NPoco. Umbraco 17.8.2
    ships NPoco 6.4.0, but 18.0.0 to 18.2.2 ship 6.2.0 and 18.3.0 ships 6.3.0, and .NET does not load a lower
    version of an assembly than the one a library was built against. 17.7.2 is the newest Umbraco 17 that ships
    NPoco 6.2.0. src/Formulate.CompatibilityCheck checks the built assemblies against each Umbraco version in CI.
  -->
  <PropertyGroup>
    <!--
      CI's compile checks build the libraries against one exact version, such as
      -p:UmbracoCompileRange=[19.0.0-rc1]. A compile range given like that is the supported range too (unless that
      is given as well), since a lower Umbraco for the meta package than its libraries ask for fails restore as a
      downgrade (NU1605). At this line, a compile range can only have come from the command line.
    -->
    <UmbracoSupportedRange Condition="'$(UmbracoSupportedRange)' == '' and '$(UmbracoCompileRange)' != ''">$(UmbracoCompileRange)</UmbracoSupportedRange>
    <UmbracoSupportedRange Condition="'$(UmbracoSupportedRange)' == ''">[17.8.2, 20.0.0)</UmbracoSupportedRange>
    <UmbracoCompileRange Condition="'$(UmbracoCompileRange)' == ''">[17.7.2, 20.0.0)</UmbracoCompileRange>
    <!-- The version the libraries compile against: the compile range's lowest, without a prerelease label. -->
    <UmbracoCompileVersion>$([System.Text.RegularExpressions.Regex]::Match('$(UmbracoCompileRange)', '\d+\.\d+\.\d+').Value)</UmbracoCompileVersion>
    <!--
      Umbraco 19 targets .NET 11 only, so a build against it does too. The packages stay one net10.0 build.
      Set here rather than only by -p:TargetFramework, which neither restore nor project references pass on.
    -->
    <TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(UmbracoCompileVersion)', '19.0.0'))">net11.0</TargetFramework>
    <!-- The exact version the dev site runs. -->
    <UmbracoSiteVersion Condition="'$(UmbracoSiteVersion)' == ''">17.8.2</UmbracoSiteVersion>
    <!-- First segment of the site version. Split as a string, since "19.0.0-rc1" is not a System.Version. -->
    <UmbracoMajor>$(UmbracoSiteVersion.Split('.')[0])</UmbracoMajor>
  </PropertyGroup>

  <!--
    UmbracoVersionRange was the single range before UmbracoSupportedRange and UmbracoCompileRange. Nothing reads
    it now, so a build given it would compile against 17.7.2, and a compile check run with the old name would pass
    without checking anything. Runs before restore and build.
  -->
  <Target Name="FormulateCheckUmbracoRanges">
    <Error Condition="'$(UmbracoVersionRange)' != ''"
           Text="UmbracoVersionRange is no longer read. To compile against one Umbraco version, use UmbracoCompileRange, such as '-p:UmbracoCompileRange=[18.3.2]'. UmbracoSupportedRange sets the Umbraco versions the Formulate package allows. See src/Directory.Build.props." />
  </Target>

  <!-- Package metadata. A project opts in to packing with <IsPackable>true</IsPackable>. -->
  <PropertyGroup>
    <VersionPrefix>5.0.0</VersionPrefix>
    <IsPackable>false</IsPackable>
    <PackageId>Umbraco.Community.$(MSBuildProjectName)</PackageId>
    <Authors>Nicholas Westby, Jamie Pollock</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.formulate.rocks/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Nicholas-Westby/formulate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco umbraco-cms forms form-builder formulate</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- MSBuild evaluates item conditions after all properties, so this sees the project's IsPackable. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\docs\nuget\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\assets\images\formulate-icon-zoomed-out.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

</Project>
