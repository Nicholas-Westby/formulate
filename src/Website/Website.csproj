<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(UmbracoMajor)' != '' and $([System.Int32]::Parse('$(UmbracoMajor)')) &gt;= 19">net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled>
    <!-- The site runs a real Umbraco version, so audit every package, not just direct references. -->
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UmbracoMajor)' != '' and $([System.Int32]::Parse('$(UmbracoMajor)')) &gt;= 18">
    <DefineConstants>$(DefineConstants);UMBRACO_18_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' != '' and $([System.Int32]::Parse('$(UmbracoMajor)')) &gt;= 19">
    <DefineConstants>$(DefineConstants);UMBRACO_19_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
    <ProjectReference Include="..\Formulate\Formulate.csproj" />
  </ItemGroup>

  <!--
    Composers/FormulateOpenApiComposer.cs uses Swashbuckle on Umbraco 17. Umbraco 18 and later build
    OpenAPI documents with Microsoft.AspNetCore.OpenApi, which Umbraco references at the version it needs.
  -->
  <ItemGroup Condition="'$(UmbracoMajor)' != '' and $([System.Int32]::Parse('$(UmbracoMajor)')) &lt; 18">
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Developer-only overrides, loaded in Debug builds. Never published. -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
