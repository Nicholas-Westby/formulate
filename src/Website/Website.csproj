<Project Sdk="Microsoft.NET.Sdk.Web" InitialTargets="FormulateCheckPackageMode">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(UmbracoMajor)' != '' and $([System.Int32]::Parse('$(UmbracoMajor)')) &gt;= 19">net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled>
    <!-- The site runs a real Umbraco version, so audit every package, not just direct references. -->
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UmbracoMajor)' != '' and $([System.Int32]::Parse('$(UmbracoMajor)')) &gt;= 18">
    <DefineConstants>$(DefineConstants);UMBRACO_18_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoMajor)' != '' and $([System.Int32]::Parse('$(UmbracoMajor)')) &gt;= 19">
    <DefineConstants>$(DefineConstants);UMBRACO_19_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
  </ItemGroup>

  <!--
    Formulate itself comes from the source projects, or with -p:FormulateFromPackages=true from the packed
    packages, to check what is shipped. That needs -p:FormulatePackageVersion=, the version of a pack in
    artifacts/packages. "npm run test:packages" in tests/e2e makes one and runs the browser tests on it.

    Each pack needs a version of its own (such as 5.0.0-local.g1a2b3c4.20261122093000): NuGet keeps the first
    copy of a version it extracts, and would never see a new pack with the same version. In this mode, restore
    reads only FormulateFromPackages.nuget.config (artifacts/packages for Formulate, nuget.org for the rest),
    extracts packages into obj/FormulatePackages instead of NuGet's global packages folder, and downloads them
    without NuGet's HTTP cache, so no package from this mode lands in NuGet's shared folders. (NuGet still
    refreshes nuget.org's service index, signing and vulnerability files in its HTTP cache, as every restore
    does.) At start-up, the site logs which Formulate it loaded (Composers/LoadedFormulateComposer.cs).
  -->
  <PropertyGroup Condition="'$(FormulateFromPackages)' == 'true'">
    <RestoreConfigFile>$(MSBuildProjectDirectory)/FormulateFromPackages.nuget.config</RestoreConfigFile>
    <RestorePackagesPath>$(MSBuildProjectDirectory)/obj/FormulatePackages/</RestorePackagesPath>
    <RestoreNoHttpCache>true</RestoreNoHttpCache>
    <!-- A Formulate package missing from the pack fails restore, rather than NuGet taking another version. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1603</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(FormulateFromPackages)' == 'true'">
    <PackageReference Include="Umbraco.Community.Formulate" VersionOverride="[$(FormulatePackageVersion)]" />
  </ItemGroup>
  <ItemGroup Condition="'$(FormulateFromPackages)' != 'true'">
    <ProjectReference Include="..\Formulate\Formulate.csproj" />
  </ItemGroup>

  <!-- Stops a mistyped switch from quietly building from source. Runs before restore and build. -->
  <Target Name="FormulateCheckPackageMode">
    <Error Condition="'$(FormulateFromPackages)' != '' and '$(FormulateFromPackages)' != 'true' and '$(FormulateFromPackages)' != 'false'"
           Text="FormulateFromPackages is '$(FormulateFromPackages)'. Use -p:FormulateFromPackages=true, or leave it out to build from source." />
    <Error Condition="'$(FormulateFromPackages)' == 'true' and '$(FormulatePackageVersion)' == ''"
           Text="-p:FormulateFromPackages=true needs -p:FormulatePackageVersion=, the version of the packs in artifacts/packages to use. Run &quot;npm run test:packages&quot; in tests/e2e to pack a new one." />
    <Error Condition="'$(FormulateFromPackages)' != 'true' and '$(FormulatePackageVersion)' != ''"
           Text="-p:FormulatePackageVersion=$(FormulatePackageVersion) is only used with -p:FormulateFromPackages=true, which is missing, so the site would be built from source." />
    <!-- A release version such as 5.0.0 could be an old pack in artifacts/packages, or one NuGet already extracted. -->
    <Error Condition="'$(FormulateFromPackages)' == 'true' and '$(FormulatePackageVersion)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(FormulatePackageVersion)', '^\d+\.\d+\.\d+-[0-9A-Za-z][0-9A-Za-z.-]*$'))"
           Text="-p:FormulatePackageVersion=$(FormulatePackageVersion) is not a version with a prerelease label, such as 5.0.0-local.g1a2b3c4. Every pack needs a version of its own: NuGet keeps the first copy of a version it extracts, so an old pack with the same version would be used instead. Run &quot;npm run pack:local&quot; in tests/e2e to pack one." />
  </Target>

  <!--
    Composers/FormulateOpenApiComposer.cs uses Swashbuckle on Umbraco 17. Umbraco 18 and later build
    OpenAPI documents with Microsoft.AspNetCore.OpenApi, which Umbraco references at the version it needs.
  -->
  <ItemGroup Condition="'$(UmbracoMajor)' != '' and $([System.Int32]::Parse('$(UmbracoMajor)')) &lt; 18">
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Developer-only overrides, loaded in Debug builds. Never published. -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <!-- Read by restore with -p:FormulateFromPackages=true. Never published. -->
    <Content Update="FormulateFromPackages.nuget.config" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
