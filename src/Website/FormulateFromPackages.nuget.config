<?xml version="1.0" encoding="utf-8"?>
<!--
  Read only when the dev site is built with -p:FormulateFromPackages=true (see Website.csproj). The name keeps
  NuGet from finding it on its own, so every other restore uses the usual settings.

  The Formulate packages come only from artifacts/packages (packed by "npm run test:packages" in tests/e2e, or
  downloaded from CI's pack job), and everything else only from nuget.org. So a Formulate package that was not
  packed fails restore, instead of coming from somewhere else.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="formulate-packs" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="formulate-packs">
      <package pattern="Umbraco.Community.Formulate" />
      <package pattern="Umbraco.Community.Formulate.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
