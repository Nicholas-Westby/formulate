{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Website.Composers.LoadedFormulateLogger": "Information",
        "Website.Composers.DevEmailStarting": "Information",
        "Website.Seed.FormulateTestContentSeeder": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Smtp": {
          "From": "formulate@example.com"
        }
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "Formulate1234!",
        "UnattendedTelemetryLevel": "Minimal"
      },
      "Hosting": {
        "Debug": true
      }
    }
  },
  "DevEcho": {
    "Folder": "umbraco/Data/Echo"
  }
}
