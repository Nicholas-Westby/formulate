<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A developer tool: it reads metadata with the BCL only, so it has no package references. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs on the shared frameworks a site runs on, to tell which assemblies the runtime gives a site (SharedFramework.cs). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Formulate.CompatibilityCheck.Tests" />
  </ItemGroup>

</Project>
