@inject Formulate.Extensions.PlainJavaScriptTemplate.Core.IBuildPlainJavaScriptJson buildJson;
@inject Formulate.Extensions.PlainJavaScriptTemplate.Core.IPlainJavaScriptAssets assets;
@model Formulate.Core.RenderModels.FormLayoutRenderModel
@{
    var randomFormId = Guid.NewGuid().ToString("N");
    var json = buildJson.Build(Model, randomFormId);

    if (string.IsNullOrWhiteSpace(json))
    {
        return;
    }

    // The theme and the script are added once per request, however many forms the page has.
    var pageAssets = assets.TakePageAssets(Context);
}
@* The wrapper holds the form's meta data (such as its name). The renderer replaces the script inside it with the form. *@
<div class="formulate-wrapper" data-form-name="@Model.Form.Name">
<script id="formulate-form-@(randomFormId)">
    (function() {

        // Variables.
        let formData, key;

        // Get the form data into JavaScript. The JSON is escaped so that
        // nothing in it (such as a label) can end the script block.
        formData = @Html.Raw(json);

        // Store the form data to an array on the window object.
        // Once the JavaScript loads, it will create this form based
        // on the data in this window object.
        key = "formulate-plain-js-forms";
        window[key] = window[key] || [];
        window[key].push(formData);

    })();
</script>
</div>
@if (pageAssets.ThemeUrl is not null)
{
    <link rel="stylesheet" href="@pageAssets.ThemeUrl" />
}
@if (pageAssets.ScriptUrl is not null)
{
    <script src="@pageAssets.ScriptUrl" defer></script>
}
