{
  "name": "formulate-plain-javascript",
  "version": "5.0.0",
  "private": true,
  "description": "Renders Formulate forms on the website with plain JavaScript (no runtime dependencies).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
