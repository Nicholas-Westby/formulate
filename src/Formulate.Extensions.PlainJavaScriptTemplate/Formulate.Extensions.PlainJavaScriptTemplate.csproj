<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- This project is annotated for nullable reference types, unlike the shared default. -->
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <!-- The view is compiled into the assembly and served from the RCL, so no files are copied to sites. -->
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <Title>Formulate.Extensions.PlainJavaScriptTemplate</Title>
        <Description>A plain JavaScript template extension for Formulate, an advanced form builder for Umbraco.</Description>
        <!-- Serve wwwroot at the site root, so the script is at /App_Plugins/Formulate/PlainJavaScript/formulate.js (not under /_content). -->
        <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
        <!-- "dotnet build" runs the renderer's npm build (see src/Directory.Build.targets). -->
        <FormulateClientDirectory>Client</FormulateClientDirectory>
        <FormulateClientOutput>wwwroot/App_Plugins/Formulate/PlainJavaScript/formulate.js</FormulateClientOutput>
        <FormulateClientOutputDirectory>wwwroot/App_Plugins/Formulate/PlainJavaScript</FormulateClientOutputDirectory>
        <FormulateClientExtraInputs>themes/**</FormulateClientExtraInputs>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Formulate.Core\Formulate.Core.csproj" />
        <ProjectReference Include="..\Formulate.Web\Formulate.Web.csproj" />
    </ItemGroup>

</Project>
