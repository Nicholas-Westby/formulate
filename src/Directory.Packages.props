<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Umbraco libraries the packages and tests build against, at the compile range (src/Directory.Build.props).
    The meta package overrides its own Umbraco reference with the supported range (src/Formulate/Formulate.csproj).
  -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="$(UmbracoCompileRange)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoCompileRange)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="$(UmbracoCompileRange)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="$(UmbracoCompileRange)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.SqlServer" Version="$(UmbracoCompileRange)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoCompileRange)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="$(UmbracoCompileRange)" />
  </ItemGroup>

  <!-- The dev site, and the Umbraco-only site of the compatibility check. -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoSiteVersion)" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="$(UmbracoSiteVersion)" />
    <!-- Builds the dev site's OpenAPI document on Umbraco 17, the version Umbraco 17.8 uses. -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!--
    Tests run through VSTest (plain `dotnet test`). The plain xunit.v3 package turns on Microsoft
    Testing Platform v2, which the .NET 10 SDK will not run through VSTest, so use its mtp-off build.
  -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <!-- Hosts controllers in memory. Matches the ASP.NET Core 10 shared framework patch the SDK installs. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <!-- Runs the submission queries against a real database in tests. Matches what Umbraco 17 uses. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
  </ItemGroup>

</Project>
