<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- This project is annotated for nullable reference types, unlike the shared default. -->
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Title>Formulate.BackOffice</Title>
    <Description>Backoffice functionality for Formulate, an advanced form builder for Umbraco.</Description>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- "dotnet build" runs the back office client's npm build (see src/Directory.Build.targets). -->
    <FormulateClientDirectory>Client</FormulateClientDirectory>
    <FormulateClientOutput>wwwroot/App_Plugins/Formulate/formulate.js</FormulateClientOutput>
    <FormulateClientOutputDirectory>wwwroot/App_Plugins/Formulate</FormulateClientOutputDirectory>
    <!-- umbraco-package.json and the welcome dashboard show the package's own version (see Client/vite.config.ts). -->
    <FormulateClientUsesVersion>true</FormulateClientUsesVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Formulate.BackOffice.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Formulate.Core\Formulate.Core.csproj" />
  </ItemGroup>

  <!--
    Checks every pack (local, CI and release): the umbraco-package.json inside the .nupkg must give the same version
    as the package's nuspec, since Umbraco's list of installed packages shows that version. A client built for
    another version, such as one left from -p:SkipClientBuild=true, fails the pack.
  -->
  <Target Name="FormulateCheckPackedVersion" AfterTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <_FormulatePackedPackage Include="@(NuGetPackOutput)" Condition="'%(Extension)' == '.nupkg'" />
    </ItemGroup>
    <PropertyGroup>
      <_FormulatePackedCheckFolder>$(IntermediateOutputPath)packed-check/$(PackageVersion)/</_FormulatePackedCheckFolder>
      <_FormulatePackedManifest>$(_FormulatePackedCheckFolder)staticwebassets/App_Plugins/Formulate/umbraco-package.json</_FormulatePackedManifest>
      <_FormulatePackedNuspec>$(_FormulatePackedCheckFolder)$(PackageId).nuspec</_FormulatePackedNuspec>
    </PropertyGroup>
    <Unzip SourceFiles="@(_FormulatePackedPackage)" DestinationFolder="$(_FormulatePackedCheckFolder)" Include="$(PackageId).nuspec;staticwebassets/App_Plugins/Formulate/umbraco-package.json" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
    <Error Condition="!Exists('$(_FormulatePackedManifest)') or !Exists('$(_FormulatePackedNuspec)')" Text="@(_FormulatePackedPackage) has no umbraco-package.json or no nuspec." />
    <PropertyGroup>
      <_FormulateNuspecVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_FormulatePackedNuspec)')), '&lt;version&gt;([^&lt;]+)&lt;/version&gt;').Groups[1].Value)</_FormulateNuspecVersion>
      <_FormulateManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_FormulatePackedManifest)')), '"version"\s*:\s*"([^"]*)"').Groups[1].Value)</_FormulateManifestVersion>
    </PropertyGroup>
    <Error Condition="'$(_FormulateManifestVersion)' != '$(_FormulateNuspecVersion)'" Text="The packed umbraco-package.json gives version '$(_FormulateManifestVersion)', but the package is $(_FormulateNuspecVersion). Build the back office client for this version (without -p:SkipClientBuild=true) before packing." />
    <Message Importance="high" Text="The packed umbraco-package.json gives $(_FormulateManifestVersion), the package's version." />
  </Target>

</Project>
