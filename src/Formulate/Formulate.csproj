<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <Title>Formulate</Title>
        <Description>An advanced form builder for Umbraco.</Description>
        <PackageTags>$(PackageTags) umbraco-marketplace</PackageTags>
        <!-- A meta package: it has no code of its own and only carries its dependencies. -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!--
          The Umbraco versions a site may run Formulate on (UmbracoSupportedRange in src/Directory.Build.props). The
          libraries this package brings in ask for less, as they compile against an older Umbraco. The Umbraco
          Marketplace lists a package only with a direct Umbraco dependency, and reads the supported versions from
          its range.
        -->
        <PackageReference Include="Umbraco.Cms.Core" VersionOverride="$(UmbracoSupportedRange)" />
        <!--
          Makes NuGet refuse Formulate on a site below the supported range. A site references Umbraco.Cms itself, so
          a higher minimum here fails its restore as a downgrade (NU1605). With Umbraco.Cms.Core alone, NuGet raises
          only the parts of Umbraco that Formulate asks for, and the site gets a mix of Umbraco versions. Umbraco's
          build steps are left out, so building this project does not copy Umbraco's JSON schema files into it.
        -->
        <PackageReference Include="Umbraco.Cms" VersionOverride="$(UmbracoSupportedRange)" ExcludeAssets="buildTransitive" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Formulate.BackOffice\Formulate.BackOffice.csproj" />
        <ProjectReference Include="..\Formulate.Extensions.PlainJavaScriptTemplate\Formulate.Extensions.PlainJavaScriptTemplate.csproj" />
        <ProjectReference Include="..\Formulate.Extensions.SendData\Formulate.Extensions.SendData.csproj" />
        <ProjectReference Include="..\Formulate.Extensions.SendEmail\Formulate.Extensions.SendEmail.csproj" />
        <ProjectReference Include="..\Formulate.Extensions.StoreData\Formulate.Extensions.StoreData.csproj" />
        <ProjectReference Include="..\Formulate.Web\Formulate.Web.csproj" />
    </ItemGroup>

</Project>
