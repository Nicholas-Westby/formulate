<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- This project is annotated for nullable reference types, unlike the shared default. -->
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <Title>Formulate.Extensions.StoreData</Title>
        <Description>A data storage extension for Formulate, an advanced form builder for Umbraco.</Description>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Migrations, scopes and the submissions table. NPoco, for the table attributes on the submission DTO, comes
          from Umbraco.Cms.Infrastructure, so a site keeps the NPoco its Umbraco ships. Depending on NPoco here would
          raise it on Umbraco versions that ship an older one, under Umbraco's own NPoco.SqlServer, which then fails
          to load (see UmbracoCompileRange in src/Directory.Build.props).
        -->
        <PackageReference Include="Umbraco.Cms.Infrastructure" />
        <PackageReference Include="Umbraco.Cms.Web.Common" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Formulate.Core\Formulate.Core.csproj" />
        <!-- The base class, section filter and result types of the submissions API. -->
        <ProjectReference Include="..\Formulate.BackOffice\Formulate.BackOffice.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Formulate.Extensions.StoreData.Tests" />
    </ItemGroup>

</Project>
