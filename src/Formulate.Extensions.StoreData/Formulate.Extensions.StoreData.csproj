<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- This project is annotated for nullable reference types, unlike the shared default. -->
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <Title>Formulate.Extensions.StoreData</Title>
        <Description>A data storage extension for Formulate, an advanced form builder for Umbraco.</Description>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!-- Migrations, scopes and the submissions table. -->
        <PackageReference Include="Umbraco.Cms.Infrastructure" />
        <!-- MapPathWebRoot for uploaded files. -->
        <PackageReference Include="Umbraco.Cms.Web.Common" />
        <!-- The table attributes on the submission DTO. -->
        <PackageReference Include="NPoco.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Formulate.Core\Formulate.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Formulate.Extensions.StoreData.Tests" />
    </ItemGroup>

</Project>
