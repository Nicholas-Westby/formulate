<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- This project is annotated for nullable reference types, unlike the shared default. -->
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <Title>Formulate.Extensions.SendData</Title>
        <Description>A data sending extension for Formulate, an advanced form builder for Umbraco.</Description>
    </PropertyGroup>

    <ItemGroup>
        <!-- IHttpClientFactory (Microsoft.Extensions.Http) is part of the ASP.NET Core shared framework. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Formulate.Core\Formulate.Core.csproj" />
    </ItemGroup>

</Project>
